# Copy to .env.local for local development. NEVER commit real values.
# In production set these in Vercel > Project > Settings > Environment Variables.

# --- Browser (Firebase web config is public by design; security comes from firestore.rules) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Leave empty. Only set if the API runs on a different domain.
VITE_API_URL=
GEMINI_API_KEY=

# --- Server only (Vercel functions) ---
# Full service-account JSON on one line (Firebase Console > Project settings > Service accounts)
FIREBASE_SERVICE_ACCOUNT=
# Gmail address + a NEW 16-character App Password (or any SMTP provider)
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_FROM="SpareShare Portal" <your-sender@example.com>
# Public portal URL used in email links, e.g. https://your-portal.vercel.app
APP_URL=
# Long random string used to sign Approve/Reject email links
ACTION_SECRET=
# Only needed once, if there is no "admin" user document in Firestore yet
ADMIN_INITIAL_PASSWORD=
ADMIN_EMAIL=
# Google Sheets sync (optional)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=
