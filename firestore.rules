rules_version = '2';

// Publish these in Firebase Console > Firestore Database > Rules
// ONLY AFTER FIREBASE_SERVICE_ACCOUNT is set in Vercel and you can log in
// (see SECURITY_SETUP.md). Users sign in through /api/login, which issues a
// Firebase token carrying their role ("admin" / "user") and plant.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.role == 'admin'; }

    // Accounts (incl. password hashes): only admins, or the user reading their own record
    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow write: if isAdmin();
    }

    match /inventory/{itemId} {
      allow read, write: if signedIn();
    }

    match /orders/{orderId} {
      allow read, create, update: if signedIn();
      allow delete: if isAdmin();
    }

    // Anyone signed in can add/read log entries; only admins can change or clear them
    match /audit_logs/{logId} {
      allow read, create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /historical_consumption/{recordId} {
      allow read, write: if signedIn();
    }

    match /upload_history/{historyId} {
      allow read, create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // Everything else (incl. the old otp_store) is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
